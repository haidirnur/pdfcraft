+/// First unsupported character in an unshaped Latin Add Text string.
+pub fn added_text_unsupported(bytes: &[u8], text: &str) -> Option<char> {
+    let font = FontRef::new(bytes).ok();
+    let map = font.as_ref().map(|f| f.charmap());
+    text.chars().filter(|c| *c != '\n').find(|c| {
+        !crate::win_ansi_encodable(*c) || !map.as_ref().and_then(|m| m.map(*c)).is_some_and(|g| g.to_u32() != 0)
+    })
+}
+
+/// Unshaped Latin advance for explicitly selected static Add Text faces.
+pub fn added_text_width(bytes: &[u8], text: &str, size: f64) -> Option<f64> {
+    let font = FontRef::new(bytes).ok()?;
+    let metrics = font.metrics(Size::unscaled(), LocationRef::default());
+    if metrics.units_per_em == 0 { return None; }
+    let glyphs = font.glyph_metrics(Size::unscaled(), LocationRef::default());
+    let map = font.charmap();
+    let mut width = 0.0;
+    for c in text.chars() {
+        width += f64::from(glyphs.advance_width(map.map(c)?)?);
+    }
+    Some(width * size / f64::from(metrics.units_per_em))
+}
