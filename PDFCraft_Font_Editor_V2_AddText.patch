+#[test]
+fn custom_added_text_roundtrip_v2() {
+    let bytes = include_bytes!("../../../assets/fonts/Inter-Regular.ttf");
+    let mut doc = text_page("BT /F1 12 Tf 72 700 Td (Unchanged source) Tj ET");
+    let font = std::sync::Arc::new(bytes.to_vec());
+    let typed = "Café — Rp 123";
+    let text = AddedText { rect: [40.0, 400.0, 350.0, 430.0], text: typed.into(),
+        custom_font: Some(font.clone()), size: 14.0, ..Default::default() };
+    assert_eq!(first_undrawable(&text), None);
+    add_content(&mut doc, 0, &Content::Text(text.clone())).unwrap();
+    let mut doc = reopen(&doc);
+    let items = list_added(&doc);
+    let Content::Text(saved) = &items[0].content else { panic!("missing editable text") };
+    assert_eq!(saved.text, typed);
+    assert_eq!(saved.custom_font.as_deref(), Some(font.as_ref()));
+    assert!(page_font_programs(&doc).iter().any(|(kind, program)|
+        kind == b"Type0" && program.as_deref() == Some(bytes.as_slice())));
+    let changed = AddedText { text: "Revised 2026".into(), ..saved.clone() };
+    update_content(&mut doc, 0, 0, &Content::Text(changed)).unwrap();
+    let doc = reopen(&doc);
+    let items = list_added(&doc);
+    let Content::Text(saved) = &items[0].content else { panic!("missing editable text") };
+    assert_eq!(saved.text, "Revised 2026");
+    assert_eq!(saved.custom_font.as_deref(), Some(font.as_ref()));
+    assert!(text::text_lines(&doc, 0).unwrap().iter().any(|l| l.text.contains("Revised 2026")));
+    let unsupported = AddedText { text: "漢".into(), ..saved.clone() };
+    assert_eq!(first_undrawable(&unsupported), Some('漢'));
+}
