+/// Register the current custom face in the preview atlas, not the default UI family.
+/// The new atlas is usable on the following frame.
+fn custom_preview_font(ctx: &egui::Context, style: &AddedText, size: f32) -> Option<egui::FontId> {
+    use std::hash::{Hash, Hasher};
+    let bytes = style.custom_font.as_ref()?;
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    bytes.hash(&mut hasher);
+    let name = format!("pdf-added-{:016x}", hasher.finish());
+    let family = egui::FontFamily::Name(name.clone().into());
+    if ctx.fonts(|f| f.definitions().families.contains_key(&family)) {
+        return Some(egui::FontId::new(size, family));
+    }
+    let mut definitions = ctx.fonts(|f| f.definitions().clone());
+    definitions.font_data.retain(|n, _| !n.starts_with("pdf-added-"));
+    definitions.families.retain(|f, _| !matches!(f, egui::FontFamily::Name(n) if n.starts_with("pdf-added-")));
+    definitions.font_data.insert(name.clone(), std::sync::Arc::new(egui::FontData::from_owned(bytes.as_ref().clone())));
+    definitions.families.insert(family, vec![name]);
+    ctx.set_fonts(definitions);
+    ctx.request_repaint();
+    None
+}
