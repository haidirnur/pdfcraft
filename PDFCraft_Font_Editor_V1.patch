+/// File selection and installed-font selection use the same validated registration path.
+fn handle_font_import(app: &mut PdfCraftApp, page: usize, block: Option<usize>, choice: Option<crate::format_text_ui::FontChoice>) {
+    use crate::format_text_ui::FontChoice;
+    let purpose = crate::files::FilePurpose::TextFont { page, block };
+    match choice {
+        Some(FontChoice::Load) => app.pick_files(purpose, false),
+        #[cfg(not(target_arch = "wasm32"))]
+        Some(FontChoice::Installed(path)) => app.use_paths(purpose, &[path]),
+        _ => {}
     }
 }
 
