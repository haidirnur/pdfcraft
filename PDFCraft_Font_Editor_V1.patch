+/// The same import actions are available before a paragraph is selected and while editing it.
+pub(crate) fn import_controls(ui: &mut egui::Ui) -> Option<FontChoice> {
+    let mut choice = None;
+    ui.horizontal_wrapped(|ui| {
+        if ui.button(tl!("Import font…"))
+            .on_hover_text(tl!("Import a static, openly licensed TTF or OTF font for this page."))
+            .clicked()
+        {
+            choice = Some(FontChoice::Load);
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        installed_fonts_menu(ui, &mut choice);
+    });
+    choice
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn installed_fonts_menu(ui: &mut egui::Ui, choice: &mut Option<FontChoice>) {
+    ui.menu_button(tl!("Installed fonts…"), |ui| {
+        ui.set_min_width(260.0);
+        let reload = ui.button(tl!("Reload")).clicked();
+        match crate::files::installed_font_files(ui.ctx(), reload) {
+            Some(list) if list.is_empty() => {
+                ui.label(tl!("No openly licensed document fonts found. Load a font file."));
+            }
+            Some(list) => {
+                let search_id = ui.scope_id().with("installed-font-search");
+                let mut query = ui.data(|d| d.get_temp::<String>(search_id)).unwrap_or_default();
+                ui.horizontal(|ui| {
+                    let (icon_rect, _) = ui.allocate_exact_size(egui::vec2(16.0, 16.0), egui::Sense::hover());
+                    crate::icons::paint(ui, icon_rect, "search", 13.0, ui.visuals().text_color().gamma_multiply(0.6));
+                    let resp = ui.add(egui::TextEdit::singleline(&mut query).hint_text(tl!("Search…")).desired_width(ui.available_width() - 8.0));
+                    if resp.changed() {
+                        ui.data_mut(|d| d.insert_temp(search_id, query.clone()));
+                    }
+                });
+                ui.separator();
+
+                let query_lower = query.trim().to_lowercase();
+                let mut families: std::collections::BTreeMap<&str, Vec<&pdfcraft_engine::text_fonts::FontFile>> = std::collections::BTreeMap::new();
+                for font in &list {
+                    if query_lower.is_empty()
+                        || font.family.to_lowercase().contains(&query_lower)
+                        || font.face.to_lowercase().contains(&query_lower)
+                    {
+                        families.entry(&font.family).or_default().push(font);
+                    }
+                }
+
+                if families.is_empty() {
+                    ui.label(tl!("No openly licensed document fonts found. Load a font file."));
+                } else {
+                    egui::ScrollArea::vertical().max_height(350.0).show(ui, |ui| {
+                        for (family, faces) in families {
+                            if faces.len() == 1 {
+                                if let Some(&font) = faces.first() {
+                                    let label = if font.face != font.family && !font.face.is_empty() { font.face.as_str() } else { family };
+                                    if ui.button(label).clicked() {
+                                        *choice = Some(FontChoice::Installed(font.path.clone()));
+                                        ui.close();
+                                    }
+                                }
+                            } else {
+                                ui.menu_button(family, |ui| {
+                                    ui.set_min_width(180.0);
+                                    for font in faces {
+                                        let label = font
+                                            .face
+                                            .strip_prefix(family)
+                                            .map(str::trim)
+                                            .filter(|s| !s.is_empty())
+                                            .unwrap_or(&font.face);
+                                        if ui.button(label).clicked() {
+                                            *choice = Some(FontChoice::Installed(font.path.clone()));
+                                            ui.close();
+                                        }
+                                    }
+                                });
+                            }
+                        }
+                    });
+                }
+            }
+            None => {
+                ui.label(tl!("Finding document fonts…"));
+            }
+        }
+    });
+}
